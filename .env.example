# Copy to .env (never committed) and fill in your cPanel FTP account.
FTP_SERVER=ftp.example.com
FTP_USERNAME=user@example.com
FTP_PASSWORD='your-password'
# Folder on the server, ending with / (often public_html/; empty = FTP account root)
FTP_DIR=public_html/
# Optional: ftps (default) or ftp
FTP_PROTOCOL=ftps
